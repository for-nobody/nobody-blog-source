<!-- ===== 项目主区域 ===== -->
<main class="projects-main">
    <!-- 默认标题区（始终可见） -->
    <div class="projects-header">
        <div class="projects-title-block">
            <h1 class="projects-big-title">
                <span class="proj-title-pre">我的</span>
                <span class="proj-title-main">项目</span>
            </h1>
            <p class="projects-subtitle">从 C++ 底层到算法设计，从解决方案到留白思考</p>
        </div>
    </div>

    <div class="project-tag-sidebar" id="projectTagSidebar" role="group" aria-label="项目分类">
        <% for (const [index, category, label, icon] of [
            [0, 'cpp', 'C++', 'fa-code'],
            [1, 'algorithm', '算法', 'fa-brain'],
            [2, 'solution', '解决方案', 'fa-lightbulb'],
            [3, 'liubai', '留白', 'fa-feather']
        ]) { %>
            <button type="button" class="btn-glass project-tag-btn" data-category="<%= category %>"
                data-index="<%= index %>" aria-controls="panel-<%= category %>" aria-pressed="false" disabled>
                <span class="project-tag-icon" aria-hidden="true"><i class="fas <%= icon %>"></i></span>
                <span class="project-tag-text"><%= label %></span>
            </button>
        <% } %>
    </div>

    <!-- 项目内容面板容器 -->
    <div class="projects-content-area" id="projectsContentArea">
        <!-- 默认空状态 -->
        <div class="project-default-panel active" id="panel-default">
            <div class="project-placeholder glass-card">
                <div class="placeholder-icon">
                    <i class="fas fa-hand-point-right"></i>
                </div>
                <h3>选择一个分类标签</h3>
                <p>选择分类，查看对应项目。</p>
            </div>
        </div>

        <!-- C++ 面板 -->
        <div class="project-category-panel" id="panel-cpp" aria-hidden="true">
            <div class="project-category-header">
                <span class="category-dot"></span>
                <h2>C++</h2>
                <span class="category-dot"></span>
            </div>
            <div class="project-empty-state glass-card">
                <div class="placeholder-icon">
                    <i class="fas fa-code"></i>
                </div>
                <h3>暂无项目</h3>
                <p>C++ 相关项目即将上线，敬请期待。</p>
            </div>
        </div>

        <!-- 算法面板 -->
        <div class="project-category-panel" id="panel-algorithm" aria-hidden="true">
            <div class="project-category-header">
                <span class="category-dot"></span>
                <h2>算法</h2>
                <span class="category-dot"></span>
            </div>
            <div class="project-empty-state glass-card">
                <div class="placeholder-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <h3>暂无项目</h3>
                <p>算法相关项目即将上线，敬请期待。</p>
            </div>
        </div>

        <!-- 解决方案面板 -->
        <div class="project-category-panel" id="panel-solution" aria-hidden="true">
            <div class="project-category-header">
                <span class="category-dot"></span>
                <h2>解决方案</h2>
                <span class="category-dot"></span>
            </div>
            <div class="project-empty-state glass-card">
                <div class="placeholder-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h3>暂无项目</h3>
                <p>解决方案相关项目即将上线，敬请期待。</p>
            </div>
        </div>

        <!-- 留白面板 -->
        <div class="project-category-panel project-panel-liubai" id="panel-liubai" aria-hidden="true">
            <div class="liubai-space">
                <div class="liubai-orb"></div>
                <div class="liubai-text">
                    <span class="liubai-symbol">∅</span>
                    <p class="liubai-motto">留白，是未言说的可能性。</p>
                    <p class="liubai-sub">—— nobody，即无限。</p>
                </div>
                <div class="liubai-orb liubai-orb-small"></div>
            </div>
        </div>
    </div>
</main>

<!-- ===== 圆形揭示遮罩层 ===== -->
<div class="circle-reveal-overlay" id="circleRevealOverlay" aria-hidden="true"></div>
