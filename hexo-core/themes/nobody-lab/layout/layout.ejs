<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- page.title ? page.title + ' | ' + config.title : config.title %></title>
    <meta name="description" content="nobody-lab 的个人博客——在确定性之外，寻找未被命名的可能。一个关于技术、生活与思考的独立空间。">
    <meta property="og:title" content="<%- page.title ? page.title + ' | ' + config.title : config.title %>">
    <meta property="og:description" content="在确定性之外，寻找未被命名的可能。—— nobody，即无限。">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="zh_CN">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%- page.title ? page.title + ' | ' + config.title : config.title %>">
    <meta name="twitter:description" content="在确定性之外，寻找未被命名的可能。—— nobody，即无限。">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%234f46e5'/><text x='50%25' y='55%25' text-anchor='middle' dy='.1em' font-size='18' fill='white' font-family='sans-serif' font-weight='bold'>n</text></svg>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- 动态加载 CSS：根据 localStorage 加载 v2 或 v3 -->
    <script>
        (function(){
            var v = localStorage.getItem('nobody-lab-version') || 'v3';
            var cssPath = '<%- url_for("/") %>style-' + v + '.css';
            document.write('<link rel="stylesheet" href="' + cssPath + '">');
        })();
    </script>
</head>

<body class="<%- is_home() ? 'page-home' : is_archive() ? 'page-articles' : is_post() ? 'page-articles' : page.layout === 'projects' ? 'page-projects' : page.layout === 'about' ? 'page-about' : page.layout === 'page' ? 'page-about' : 'page-articles' %>">

    <!-- 左上角导航 -->
    <nav class="glass-nav-vertical">
        <a href="<%- url_for('/') %>" class="nav-btn-glass <%- is_home() ? 'active' : '' %>">
            <span class="nav-btn-icon"><i class="fas fa-meteor"></i></span>
            <span class="nav-btn-label">首页</span>
        </a>
        <a href="<%- url_for('/about/') %>" class="nav-btn-glass <%- is_current('about/') ? 'active' : '' %>">
            <span class="nav-btn-icon"><i class="fas fa-user-astronaut"></i></span>
            <span class="nav-btn-label">关于我</span>
        </a>
        <a href="<%- url_for('/archives/') %>" class="nav-btn-glass <%- is_archive() || is_post() ? 'active' : '' %>">
            <span class="nav-btn-icon"><i class="fas fa-scroll"></i></span>
            <span class="nav-btn-label">文章</span>
        </a>
        <a href="<%- url_for('/projects/') %>" class="nav-btn-glass <%- page.layout === 'projects' ? 'active' : '' %>">
            <span class="nav-btn-icon"><i class="fas fa-flask"></i></span>
            <span class="nav-btn-label">项目</span>
        </a>
        <button type="button" class="nav-btn-glass theme-toggle-btn" id="themeToggle" aria-label="切换主题">
            <span class="nav-btn-icon">
                <i class="fas fa-moon theme-icon-moon"></i>
                <i class="fas fa-sun theme-icon-sun"></i>
            </span>
            <span class="nav-btn-label">主题</span>
        </button>
    </nav>

    <!-- 阅读进度条 -->
    <div id="progress-bar"></div>

    <!-- 高饱和旋转背景 -->
    <div class="vortex-bg">
        <div class="vortex-ring ring-a"></div>
        <div class="vortex-ring ring-b"></div>
        <div class="vortex-ring ring-c"></div>
        <div class="vortex-ring ring-d"></div>
        <div class="vortex-core"></div>
        <div class="vortex-particles" id="particlesContainer"></div>
    </div>

    <!-- 页面主体内容 -->
    <%- body %>

    <!-- ===== 页脚 ===== -->
    <footer class="footer-minimal">
        <!-- ===== UI 版本切换开关 ===== -->
        <div class="version-switch-container" id="versionSwitchContainer">
            <span class="version-label v2-label">Apple v2</span>
            <button class="version-toggle" id="versionToggle" aria-label="切换UI版本">
                <span class="toggle-thumb"></span>
            </button>
            <span class="version-label v3-label">Acid v3</span>
        </div>

        <div class="footer-symbol">
            <span class="symbol-circle"></span>
            <span class="symbol-text">nobody-lab</span>
            <span class="symbol-circle"></span>
        </div>
        <p class="footer-copy">&copy; 2026 nobody-lab</p>
        <div class="footer-social-mini">
            <a href="#" aria-label="GitHub"><i class="fab fa-github"></i></a>
            <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            <a href="#" aria-label="Bilibili"><i class="fab fa-bilibili"></i></a>
        </div>
    </footer>

    <!-- 动态加载 JS -->
    <script>
        (function(){
            var v = localStorage.getItem('nobody-lab-version') || 'v3';
            var jsPath = '<%- url_for("/") %>script-' + v + '.js';
            document.write('<script src="' + jsPath + '"><\/script>');
        })();
    </script>
</body>
</html>