<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%
        const pageName = page.title || (is_tag() ? page.tag : is_category() ? page.category : is_archive() ? '文章' : '');
        const documentTitle = pageName ? pageName + ' | ' + config.title : config.title;
        const articleSection = is_archive() || is_post() || is_category() || is_tag();
    %>
    <title><%= documentTitle %></title>
    <meta name="description" content="nobody-lab 的个人博客——在确定性之外，寻找未被命名的可能。一个关于技术、生活与思考的独立空间。">
    <meta property="og:title" content="<%= documentTitle %>">
    <meta property="og:description" content="在确定性之外，寻找未被命名的可能。—— nobody，即无限。">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="zh_CN">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= documentTitle %>">
    <meta name="twitter:description" content="在确定性之外，寻找未被命名的可能。—— nobody，即无限。">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%234f46e5'/><text x='50%25' y='55%25' text-anchor='middle' dy='.1em' font-size='18' fill='white' font-family='sans-serif' font-weight='bold'>n</text></svg>" />
    <script src="<%= url_for('site.js') %>"
        data-apple-style="<%= url_for('style-v2.css') %>" data-acid-style="<%= url_for('style-v3.css') %>"
        data-apple-script="<%= url_for('script-v2.js') %>" data-acid-script="<%= url_for('script-v3.js') %>"></script>
    <noscript><link rel="stylesheet" href="<%= url_for('style-v3.css') %>"></noscript>
    <link rel="stylesheet" href="<%= url_for('site.css') %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="<%- is_home() ? 'page-home' : is_archive() ? 'page-articles' : is_post() ? 'page-articles' : page.layout === 'projects' ? 'page-projects' : page.layout === 'about' ? 'page-about' : page.layout === 'page' ? 'page-about' : 'page-articles' %>">

    <!-- 左上角导航 -->
    <nav class="glass-nav-vertical" aria-label="主导航">
        <a href="<%= url_for('/') %>" class="nav-btn-glass <%= is_home() ? 'active' : '' %>"<% if (is_home()) { %> aria-current="page"<% } %>>
            <span class="nav-btn-icon" aria-hidden="true"><i class="fas fa-meteor"></i></span>
            <span class="nav-btn-label">首页</span>
        </a>
        <a href="<%= url_for('about/') %>" class="nav-btn-glass <%= page.layout === 'about' ? 'active' : '' %>"<% if (page.layout === 'about') { %> aria-current="page"<% } %>>
            <span class="nav-btn-icon" aria-hidden="true"><i class="fas fa-user-astronaut"></i></span>
            <span class="nav-btn-label">关于我</span>
        </a>
        <a href="<%= url_for(config.archive_dir + '/') %>" class="nav-btn-glass <%= articleSection ? 'active' : '' %>"<% if (articleSection) { %> aria-current="<%= is_current(config.archive_dir + '/', true) ? 'page' : 'location' %>"<% } %>>
            <span class="nav-btn-icon" aria-hidden="true"><i class="fas fa-scroll"></i></span>
            <span class="nav-btn-label">文章</span>
        </a>
        <a href="<%= url_for('projects/') %>" class="nav-btn-glass <%= page.layout === 'projects' ? 'active' : '' %>"<% if (page.layout === 'projects') { %> aria-current="page"<% } %>>
            <span class="nav-btn-icon" aria-hidden="true"><i class="fas fa-flask"></i></span>
            <span class="nav-btn-label">项目</span>
        </a>
        <button type="button" class="nav-btn-glass theme-toggle-btn" id="themeToggle" aria-label="浅色主题" aria-pressed="false" disabled>
            <span class="nav-btn-icon" aria-hidden="true">
                <i class="fas fa-moon theme-icon-moon"></i>
                <i class="fas fa-sun theme-icon-sun"></i>
            </span>
            <span class="nav-btn-label">主题</span>
        </button>
    </nav>

    <!-- 阅读进度条 -->
    <div id="progress-bar" aria-hidden="true"></div>

    <!-- 高饱和旋转背景 -->
    <div class="vortex-bg" aria-hidden="true">
        <div class="vortex-ring ring-a"></div>
        <div class="vortex-ring ring-b"></div>
        <div class="vortex-ring ring-c"></div>
        <div class="vortex-ring ring-d"></div>
        <div class="vortex-core"></div>
        <div class="vortex-particles" id="particlesContainer"></div>
    </div>

    <!-- 页面主体内容 -->
    <%- body %>

    <!-- ===== 页脚 ===== -->
    <footer class="footer-minimal">
        <!-- ===== UI 版本切换开关 ===== -->
        <div class="version-switch-container version-v3-active" id="versionSwitchContainer">
            <span class="version-label v2-label">Apple v2</span>
            <button type="button" class="version-toggle" id="versionToggle" aria-label="Acid v3 界面" aria-pressed="true" disabled>
                <span class="toggle-thumb"></span>
            </button>
            <span class="version-label v3-label">Acid v3</span>
        </div>

        <div class="footer-symbol">
            <span class="symbol-circle"></span>
            <span class="symbol-text">nobody-lab</span>
            <span class="symbol-circle"></span>
        </div>
        <p class="footer-copy">&copy; 2026 nobody-lab</p>
        <% if (config.social?.github) { %>
            <div class="footer-social-mini">
                <a href="<%= config.social.github %>" aria-label="GitHub" title="GitHub">
                    <i class="fab fa-github" aria-hidden="true"></i>
                </a>
            </div>
        <% } %>
    </footer>

</body>
</html>
