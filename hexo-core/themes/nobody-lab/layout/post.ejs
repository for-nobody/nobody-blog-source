<main class="about-main post-main">
    <article>
        <header class="about-staggered-title">
            <h1 class="about-big-title post-title"><%= page.title %></h1>
            <% const published = date(page.date, 'YYYY-MM-DD'); %>
            <p class="post-meta"><time datetime="<%= published %>"><%= published %></time></p>
            <% for (const [label, terms] of [['分类', page.categories], ['标签', page.tags]]) { %>
                <% if (terms?.length) { %>
                    <ul class="post-taxonomies" aria-label="<%= label %>">
                        <% terms.forEach(term => { %>
                            <li><a href="<%= url_for(term.path) %>"><%= term.name %></a></li>
                        <% }); %>
                    </ul>
                <% } %>
            <% } %>
        </header>
        <div class="post-content glass-card"><%- page.content %></div>
    </article>
</main>
