<%
    const { categories, articles } = archive_articles(page.posts);
    const archiveUrl = url_for(config.archive_dir + '/');
    const scoped = is_category() || is_tag() || page.year;
    const heading = is_category() ? page.category : is_tag() ? page.tag :
        [page.year, page.month, page.day].filter(Boolean).join(' / ');
    const illustrations = [
        ['card-size-lg', '', '#667eea, #764ba2', 'fa-laptop-code'],
        ['card-size-md', 'card-offset-right', '#f093fb, #f5576c', 'fa-camera-retro'],
        ['card-size-sm', '', '#4facfe, #00f2fe', 'fa-brain'],
        ['card-size-md', '', '#a18cd1, #fbc2eb', 'fa-graduation-cap'],
        ['card-size-sm', 'card-offset-left', '#fa709a, #fee140', 'fa-cloud'],
        ['card-size-lg', '', '#5ee7df, #b490ca', 'fa-book-open']
    ];
%>
<main class="articles-main" data-article-archive>
    <header class="articles-header">
        <div class="articles-title-block">
            <h1 class="articles-big-title">
                <% if (scoped) { %>
                    <span class="art-title-main"><%= heading %></span>
                <% } else { %>
                    <span class="art-title-pre">最新</span>
                    <span class="art-title-main">文章</span>
                <% } %>
            </h1>
            <% if (scoped) { %>
                <a href="<%= archiveUrl %>">查看所有文章</a>
            <% } else { %>
                <p class="articles-subtitle">探索技术深度，分享生活温度</p>
            <% } %>
        </div>
    </header>

    <% if (articles.length) { %>
        <section class="articles-tree-container" id="articlesTree" aria-label="树状文章分类" hidden>
            <svg class="tree-svg" viewBox="0 0 1000 800" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <path class="tree-trunk" d="M 120 720 Q 280 530, 430 380 Q 520 290, 600 180"/>
                <path class="tree-branch" data-branch="tech" d="M 365 495 Q 480 450, 600 435"/>
                <path class="tree-branch" data-branch="life" d="M 435 380 Q 340 310, 220 275"/>
                <path class="tree-branch" data-branch="thought" d="M 525 260 Q 640 210, 750 195"/>
                <path class="tree-branch" data-branch="tutorial" d="M 575 195 Q 500 130, 390 105"/>
                <circle class="tree-node tree-node-root" cx="120" cy="720" r="4"/>
                <circle class="tree-node tree-node-tip" cx="600" cy="180" r="3"/>
            </svg>
            <% for (const category of categories.filter(category => category.position)) { %>
                <div class="tree-category" data-category="<%= category.key %>" style="<%= category.position %>">
                    <button type="button" class="btn-glass tree-tag-btn" data-category="<%= category.key %>"
                        aria-expanded="false" aria-controls="droplet-<%= category.key %>">
                        <i class="fas <%= category.icon %>" aria-hidden="true"></i> <%= category.label %>
                    </button>
                    <div class="tree-droplet glass-card" id="droplet-<%= category.key %>" hidden>
                        <% const posts = articles.filter(article => article.groups.includes(category.key)); %>
                        <% if (posts.length) { %>
                            <ul class="droplet-articles">
                                <% for (const article of posts) { %>
                                    <li class="droplet-article">
                                        <a class="droplet-title" href="<%= url_for(article.post.path) %>"><%= article.post.title %></a>
                                        <time datetime="<%= article.date %>"><%= article.date %></time>
                                    </li>
                                <% } %>
                            </ul>
                        <% } else { %>
                            <p>本页暂无<%= category.label %>文章。</p>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </section>

        <div class="archive-filters" role="group" aria-label="筛选本页文章" hidden>
            <% for (const category of categories) { %>
                <button type="button" class="btn-glass filter-pill<%= category.key === 'all' ? ' active' : '' %>"
                    data-filter="<%= category.key %>" aria-controls="articleCards"
                    aria-pressed="<%= category.key === 'all' %>">
                    <i class="fas <%= category.icon %>" aria-hidden="true"></i> <%= category.label %>
                </button>
            <% } %>
        </div>
        <p class="archive-empty" role="status" data-filter-empty hidden>本页没有符合此分类的文章。</p>

        <div class="articles-waterfall" id="articleCards">
            <% articles.forEach(({ post, groups, names, summary, date }, index) => {
                const [size, offset, gradient, icon] = illustrations[index % illustrations.length];
            %>
                <article class="article-card-waterfall <%= size %> <%= offset %>" data-category="<%= groups.join(' ') %>">
                    <div class="card-glass-surface">
                        <div class="card-glass-image" style="--card-gradient: linear-gradient(135deg, <%= gradient %>);" aria-hidden="true">
                            <i class="fas <%= icon %>"></i>
                        </div>
                        <div class="card-glass-body">
                            <span class="card-glass-category"><%= names.join('、') || '未分类' %></span>
                            <div class="card-glass-meta">
                                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                                <time datetime="<%= date %>"><%= date %></time>
                            </div>
                            <h2><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
                            <p><%= summary %></p>
                            <a href="<%= url_for(post.path) %>" class="card-glass-link" aria-label="阅读全文：<%= post.title %>">
                                阅读全文 <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>
            <% }); %>
        </div>
    <% } else { %>
        <p class="archive-empty" role="status">暂无文章。</p>
    <% } %>

    <% if (page.total > 1) { %>
        <nav class="archive-pagination" aria-label="文章分页">
            <% if (page.prev) { %>
                <a class="btn-glass" href="<%= url_for(page.prev_link) %>" rel="prev">上一页</a>
            <% } %>
            <span>第 <%= page.current %> / <%= page.total %> 页</span>
            <% if (page.next) { %>
                <a class="btn-glass" href="<%= url_for(page.next_link) %>" rel="next">下一页</a>
            <% } %>
        </nav>
    <% } %>
</main>
